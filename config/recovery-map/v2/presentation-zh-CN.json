  "modules": [
    {"id":"assets-accounts","title":"资产与账户清单","summary":"有哪些资产账户、钱包或存储载体？","collection":"assets","fields":[{"id":"client_id","field_type":"text","hidden":true,"requirement":"REQUIRED"},{"id":"platform","field_type":"choice","label":"平台或钱包名称","options":["binance","okx","coinbase","custom"],"requirement":"REQUIRED"},{"id":"registration_geography","field_type":"choice","label":"账户所属国家或地区","options":["Australia","New Zealand","United States","EEA","United Kingdom","Hong Kong","Singapore","Japan","UAE","Canada","Other"],"requirement":"CONDITIONALLY_REQUIRED"},{"id":"account_class","field_type":"choice","label":"账户类型","options":["Personal","Institutional"],"requirement":"CONDITIONALLY_REQUIRED"},{"id":"nickname","field_type":"text","label":"备注名称（选填）","requirement":"OPTIONAL"},{"id":"type","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"label","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"exists","field_type":"boolean","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"platform_hint","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"client_mode","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"enabled_factors","field_type":"multi_choice","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"selected_path","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"}],"guidance":{"why":"先列清未来恢复人需要处理的每一个账户。","what":"选择平台；托管平台再选择注册地区和账户类型。同平台多账户请填写备注名称。","avoid":"不要填写账号全名、密码、私钥、助记词、验证码或API Secret。","omissions":"同一平台有多个账户但没有可区分的备注。","attachments":"可为具体账户或全部账户添加脱敏辅助材料。","unsure":"暂时不确定细节也可先创建账户，最终Review前必须补齐必填项。"}},
    {"id":"recovery-conditions","title":"恢复所需条件与资料","summary":"恢复每个具体账户需要哪些条件？","collection":"recovery_conditions","card_scope":"ACCOUNT","fields":[{"id":"client_id","field_type":"text","hidden":true,"requirement":"REQUIRED"},{"id":"asset_ref","field_type":"relation","hidden":true,"requirement":"REQUIRED"},{"id":"selected_conditions","field_type":"multi_choice","label":"恢复所需条件（多选）","options":["email","phone","password","authenticator","passkey","security_key","identity","new_device","withdrawal_allowlist","fund_password","other"],"requirement":"REQUIRED"},{"id":"notes","field_type":"long_text","label":"补充备注（选填）","requirement":"OPTIONAL"},{"id":"saved","field_type":"boolean","hidden":true,"requirement":"REQUIRED"},{"id":"unknown_conditions","field_type":"multi_choice","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"later_conditions","field_type":"multi_choice","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"type","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"readiness","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"availability","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"exists","field_type":"boolean","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"location_hint","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"fallback_scenario","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"fallback_action","field_type":"long_text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"fallback_stop","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"}],"guidance":{"why":"未来恢复人必须知道每个账户需要准备哪些条件。","what":"在一张账户卡中勾选所有实际适用的条件；只记录秘密的存在性。","avoid":"不得填写密码、OTP、Authenticator Seed、恢复码、助记词、私钥或API Secret原文。","omissions":"账户没有选择任何适用条件。","attachments":"附件是选填辅助材料，并绑定该账户。","unsure":"不确定的条件可暂不勾选；最终至少选择一个确定适用条件。"}},
    {"id":"locations-finding","title":"位置与查找","summary":"已选择的资料、设备和条件在哪里？","collection":"locations","fields":[{"id":"client_id","field_type":"text","hidden":true,"requirement":"REQUIRED"},{"id":"condition_ref","field_type":"relation","hidden":true,"requirement":"REQUIRED"},{"id":"asset_ref","field_type":"relation","hidden":true,"requirement":"REQUIRED"},{"id":"covered_by_summary","field_type":"boolean","hidden":true,"requirement":"OPTIONAL"},{"id":"type","field_type":"choice","label":"位置类型","options":["物理位置","设备","应用","线上入口线索","密码管理器或加密文件","保险箱或保管设施","其他"],"requirement":"CONDITIONALLY_REQUIRED"},{"id":"label","field_type":"text","label":"位置名称","requirement":"CONDITIONALLY_REQUIRED"},{"id":"finding_instructions","field_type":"long_text","label":"查找说明","requirement":"CONDITIONALLY_REQUIRED"}],"guidance":{"why":"恢复条件只有被找到才有实际价值。","what":"逐项填写，或使用账户汇总说明/附件覆盖多项，也可混合使用。","avoid":"不要填写明文密码、私钥、助记词、OTP或完整恢复码。","omissions":"已选择条件既没有逐项位置，也没有被汇总材料覆盖。","attachments":"逐项和汇总附件都会记录覆盖条件。","unsure":"可先填写已知条件；未覆盖项保持未完成并在Review中定位。"}},
    {"id":"contacts-assistance","title":"协助人","summary":"是否需要他人在某些环节提供协助？","collection":"contacts","fields":[{"id":"client_id","field_type":"text","hidden":true,"requirement":"OPTIONAL"},{"id":"assistance_state","field_type":"choice","label":"是否需要协助","options":["YES","NO","UNKNOWN"],"requirement":"OPTIONAL"},{"id":"needed","field_type":"boolean","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"label","field_type":"text","label":"协助人或机构名称","requirement":"CONDITIONALLY_REQUIRED"},{"id":"role","field_type":"choice","label":"协助人角色","options":["家人或朋友","律师","会计师","技术顾问","平台官方支持","其他专业机构"],"requirement":"CONDITIONALLY_REQUIRED"},{"id":"when_to_contact","field_type":"text","label":"什么时候联系","requirement":"CONDITIONALLY_REQUIRED"},{"id":"can_help","field_type":"long_text","label":"可以协助什么","requirement":"CONDITIONALLY_REQUIRED"},{"id":"assistance_boundary","field_type":"long_text","label":"不得接触什么","requirement":"CONDITIONALLY_REQUIRED"}],"guidance":{"why":"遇到设备、认证或官方流程问题时，需要知道该找谁。","what":"模块整体可选；选择需要协助后，再说明角色、联系时机、事项和边界。","avoid":"不得让任何单一协助人集中掌握全部秘密和控制条件。","omissions":"选择需要协助，却没有写清角色、时机或边界。","attachments":"可添加脱敏协助说明。","unsure":"暂不确定不会阻止核心Recovery Map生成。"}},
    {"id":"recovery-order-exceptions","title":"恢复与转移步骤","summary":"每个平台或钱包应如何恢复和安全转移？","collection":"recovery_steps","fields":[{"id":"client_id","field_type":"text","hidden":true,"requirement":"REQUIRED"},{"id":"asset_ref","field_type":"relation","hidden":true,"requirement":"REQUIRED"},{"id":"action","field_type":"long_text","label":"恢复与转移步骤","requirement":"CONDITIONALLY_REQUIRED"},{"id":"risk_notes","field_type":"long_text","label":"风险提示（选填）","requirement":"OPTIONAL"},{"id":"no_special_risk","field_type":"boolean","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"saved","field_type":"boolean","hidden":true,"requirement":"REQUIRED"},{"id":"saved_at","field_type":"text","hidden":true,"requirement":"OPTIONAL"},{"id":"risk_level","field_type":"choice","hidden":true,"options":["low","medium","high","critical"],"requirement":"OPTIONAL"},{"id":"completion_check","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"failure_action","field_type":"long_text","hidden":true,"legacy":true,"requirement":"OPTIONAL"},{"id":"stop_condition","field_type":"text","hidden":true,"legacy":true,"requirement":"OPTIONAL"}],"guidance":{"why":"恢复人需要按账户看到清晰的恢复与安全转移顺序。","what":"您可以直接填写恢复与转移步骤，也可以上传包含完整步骤的附件；完成其中一种即可，也可以同时使用。","avoid":"不要写绕过身份验证、无条件转账或向协助人泄露秘密的步骤。","omissions":"平台既没有步骤文字，也没有有效步骤附件。","attachments":"步骤附件和风险附件分别绑定具体平台账户与用途。","unsure":"可先保存草稿；最终必须有步骤文字或附件，风险提示可留空。"}},
    {"id":"evidence-messages","title":"给未来恢复人的嘱托","summary":"传承人还有什么个人说明或嘱托？","collection":"attachments","fields":[{"id":"personal_message","field_type":"long_text","label":"给未来恢复人的留言（可跳过）","requirement":"OPTIONAL"}],"guidance":{"why":"个人留言可以帮助未来恢复人理解背景。","what":"可使用文字、图片、音频或短视频，也可完全跳过。","avoid":"不要暴露完整密码、私钥、助记词或验证码。","omissions":"附件没有用途或来源归属。","attachments":"本模块附件仍进入独立附件中心。","unsure":"没有合适内容可以跳过。"}}
  ]
}
