  "allowed_media":[
    {"category":"文档","mime_prefixes":["application/pdf","application/json","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain","text/markdown"],"extensions":["pdf","docx","txt","md","json"]},
    {"category":"图片","mime_prefixes":["image/jpeg","image/png","image/webp"],"extensions":["jpg","jpeg","png","webp"]},
    {"category":"语音说明","mime_prefixes":["audio/mpeg","audio/mp4","audio/x-m4a","audio/wav","audio/x-wav"],"extensions":["mp3","m4a","wav"]},
    {"category":"短视频说明","mime_prefixes":["video/mp4","video/quicktime","video/webm"],"extensions":["mp4","mov","webm"]},
